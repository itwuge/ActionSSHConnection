# =========** 文件头 =========**
# 文件        : uptermd.service
# 所属目录    : deploy/
# 文件用途    : 以 systemd 常驻方式运行自托管 uptermd 中转服务, 承载 relay 的 SSH 监听与 Prometheus 指标
# 架构定位    : 中转端进程托管层; 上游是 deploy/install-uptermd.sh 写入的 /etc/uptermd/uptermd.env, 下游是 uptermd 二进制
# 核心功能    : 以专用系统用户运行, 读取环境文件中的监听地址与密钥路径, 施加内存与 CPU 与任务数上限, 崩溃自动重启
# 职责边界    : 不负责安装二进制, 不负责生成密钥, 不负责防火墙; 参数一律来自环境文件, 本单元不写死端口
# 运行环境    : Ubuntu 20.04 及以上 systemd 245 及以上, 二进制位于 /usr/local/bin/uptermd
# 依赖关系    : 依赖 /etc/uptermd/uptermd.env 与 /var/lib/uptermd/server_key; 由 install-uptermd.sh 安装到 /etc/systemd/system/

[Unit]
Description=uptermd relay (self-hosted)
Documentation=https://upterm.dev/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=upterm
Group=upterm

# 环境文件是唯一参数来源: UPTERMD_SSH_ADDR, UPTERMD_PRIVATE_KEY, UPTERMD_AUTHORIZED_KEYS,
# UPTERMD_HANDSHAKE_TIMEOUT, UPTERMD_METRIC_ADDR, UPTERMD_SSH_NETWORK.
# 不加 "-" 前缀, 文件缺失时启动直接失败, 避免无参数裸跑.
EnvironmentFile=/etc/uptermd/uptermd.env
ExecStart=/usr/local/bin/uptermd

Restart=always
RestartSec=5s
TimeoutStopSec=20s

# 资源上限按设计稿: 2 vCPU / 2 GiB 中转机上留出余量
MemoryMax=1G
CPUQuota=150%
TasksMax=512
LimitNOFILE=65536

# 最小权限: 只读系统, 只写状态目录, 独立 tmp, 禁止提权与内核面改动
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

# 状态与密钥目录由 systemd 创建并确保属主, 权限 0750
StateDirectory=uptermd
StateDirectoryMode=0750
ReadWritePaths=/var/lib/uptermd

StandardOutput=journal
StandardError=journal
SyslogIdentifier=uptermd

[Install]
WantedBy=multi-user.target
